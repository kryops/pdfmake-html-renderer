{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    "docs": true,
    "**/.yarn": true
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "js/ts.experimental.useTsgo": false,
}